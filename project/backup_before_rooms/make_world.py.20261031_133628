def dining_table(name, x, y, length=1.4, width=0.8, yaw=0.0):
    local_box(name, x, y, yaw, 0, 0, length, width, 0.04, WOOD, 0.72, 'top')
    for i, (sx_, sy_) in enumerate(((-1, -1), (1, -1), (1, 1), (-1, 1))):
